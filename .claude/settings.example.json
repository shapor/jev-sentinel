{
  "_comment": "Prefer `make install-hook DIR=... SCOPE=...`, which writes these with the real path.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/jev-sentinel/hook.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/jev-sentinel/hook.py post"
          }
        ]
      }
    ]
  }
}
